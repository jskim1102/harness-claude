# orca-harness.service — Orca 원격 런타임을 systemd user 서비스로 상시 구동.
# 하네스 전체(CEO/CTO 터미널·라우팅)가 Orca 위에서 돌므로 이 유닛이 부팅 앵커다.
# 설치/갱신: ./run.sh install-services  (@…@ 플레이스홀더는 설치 시 치환)
# 포트/pairing 주소·추가 serve 플래그는 ~/.config/harness-claude/orca-server.env 가
# 유일 소스. ORCA_SERVE_EXTRA_ARGS 는 선택 — 예: --mobile-pairing (모바일 QR 발급).
[Unit]
Description=Harness Orca remote runtime
Documentation=https://www.onorca.dev/docs/remote-servers
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@HARNESS_ROOT@
Environment=HOME=@HOME@
Environment=HARNESS_ROOT=@HARNESS_ROOT@
Environment=PATH=@SERVICE_PATH@
EnvironmentFile=@HOME@/.config/harness-claude/orca-server.env
# Orca 1.4.198+ 는 serve 를 실행한 바이너리가 자기 몸을 ~/.cache/orca/appimage/<hash>/ 에
# 복사하고 ~/.local/bin/orca 디스패처를 그 복사본에 고정한다(stable-launcher). 디스패처로
# serve 하면 AppImage 를 바꿔도 영원히 옛 복사본이 뜬다 — update-orca 가 2026-09-10 부터
# 5연속 "ready 안 됨" 롤백한 원인(2026-10-06 확정). 그래서 유닛은 AppImage 를 직접 실행한다:
# 기동 시 Orca 가 스스로 재추출·재등록하므로 CLI 디스패처는 설치본을 자동 추종한다.
# 경로는 scripts/orca-update.sh 의 APPIMAGE 와 같아야 한다.
ExecStartPre=/usr/bin/test -x @HOME@/apps/orca/orca-linux.AppImage
# 기동 전에 유닛 밖에서 살아남은 Orca 프로세스를 거둔다. 유닛이 죽으면
# (core-dump/exit-code 실측) AppImage 자식들이 systemd 직속으로 재부모화돼
# 살아남고, 그러면 유닛은 failed 인데 프로세스는 떠 있어 stop 이 닿지 않고
# start 는 자원을 문 고아와 충돌한다 = '종료·실행이 맘대로 안 되는' 증상.
# `-` 접두사: 수거 실패가 기동을 막지 않는다.
ExecStartPre=-@HARNESS_ROOT@/scripts/orca-reap-orphans.sh
# $ORCA_SERVE_EXTRA_ARGS 는 의도적으로 ${} 가 아니다 — systemd 는 $VAR 만 공백으로
# 쪼개 0개 이상의 인자로 넘긴다(${VAR} 는 통짜 1개 인자라 미설정 시 빈 인자가 생긴다).
ExecStart=@HOME@/apps/orca/orca-linux.AppImage serve --port ${ORCA_PORT} --pairing-address ${ORCA_PAIRING_ADDRESS} $ORCA_SERVE_EXTRA_ARGS
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
